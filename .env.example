# ===================================================
# Qoneqt ContentOS - Environment Configuration
# ===================================================

# Set to "true" to use local mock pipeline and instant demo simulation
# Set to "false" to connect to your teammate's live backend APIs
NEXT_PUBLIC_USE_MOCK_API=true

# Base URL for the backend AI content pipeline
# (Leave default for local backend development or set to production backend URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
